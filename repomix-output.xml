"""
AyurVision RAG — Query pipeline.
Retrieves relevant chunks from ChromaDB and generates answers using Groq
(free tier — llama-3.1-8b-instant). No credit card required.
Get your free API key at: https://console.groq.com
"""

import os
import logging
from pathlib import Path
from dotenv import load_dotenv

import chromadb
from chromadb.utils import embedding_functions
from groq import Groq

# Resolve ai-service directory (parent of rag/)
_QUERY_FILE = Path(__file__).resolve()
_AI_SERVICE_ROOT = _QUERY_FILE.parent.parent

def _ensure_env_loaded():
    """Load .env from ai-service so Groq key is found regardless of CWD."""
    for name in (".env", ".env.example"):
        path = _AI_SERVICE_ROOT / name
        if path.exists():
            load_dotenv(path)
            break

_ensure_env_loaded()

logger = logging.getLogger(__name__)

SCRIPT_DIR = Path(__file__).resolve().parent
AI_SERVICE_DIR = SCRIPT_DIR.parent
CHROMA_PATH = AI_SERVICE_DIR / "chroma_db"
COLLECTION_NAME = "ayurvision_plants"
EMBED_MODEL = "all-MiniLM-L6-v2"
GROQ_MODEL = "llama-3.1-8b-instant"  # free, fast, good quality

# Singletons
_collection = None
_groq_client = None


def get_collection():
    global _collection
    if _collection is not None:
        return _collection
    client = chromadb.PersistentClient(path=str(CHROMA_PATH))
    ef = embedding_functions.SentenceTransformerEmbeddingFunction(
        model_name=EMBED_MODEL
    )
    _collection = client.get_or_create_collection(
        name=COLLECTION_NAME,
        embedding_function=ef,
        metadata={"hnsw:space": "cosine"},
    )
    return _collection


def get_groq():
    global _groq_client
    if _groq_client is not None:
        return _groq_client
    _ensure_env_loaded()  # Reload in case .env was added after import
    api_key = (os.environ.get("GROQ_API_KEY") or "").strip()
    if not api_key:
        raise ValueError(
            "GROQ_API_KEY is not set. "
            "Get a free key at https://console.groq.com and add it to ai-service/.env"
        )
    _groq_client = Groq(api_key=api_key)
    return _groq_client


SYSTEM_PROMPT = """You are AyurVision's Ayurvedic medical knowledge assistant, designed
to support qualified Ayurvedic doctors and practitioners. You have deep expertise in:

CLINICAL KNOWLEDGE:
- Tridosha theory (Vata, Pitta, Kapha) and Prakriti assessment
- Classical Nidana (disease etiology) and Samprapti (pathogenesis)
- All 8 branches of Ashtanga Ayurveda including Kayachikitsa, Shalya, Shalakya,
  Kaumarabhritya, Agada Tantra, Bhutavidya, Rasayana, and Vajikarana

PHARMACOLOGY:
- Classical formulations (Churna, Kashaya, Ghrita, Vati, Asava, Arishta, Bhasma)
- Herb-drug interactions and contraindications
- Dosage calculations for adults, elderly, and pediatric patients
- Heavy metal Bhasma safety and GMP considerations

PANCHAKARMA:
- All 5 procedures with indications, contraindications, preparatory steps
- Purvakarma (Snehana + Swedana), main procedures, Paschatkarma
- Samsarjana Krama (post-procedure diet)

DAILY REGIMEN:
- Dinacharya (daily routine), Ritucharya (seasonal regimen)
- Pathya-Apathya (dietary dos and don'ts) for specific diseases

BASE YOUR ANSWERS STRICTLY on the provided context. For drug interactions and dosages,
always add a clinical caution. If context is insufficient, say so and recommend
consulting classical texts or a senior Vaidya. Never fabricate dosages or claim
curative efficacy without evidence in the context.

Format clinical answers with clear sections: Indications | Dosage | Contraindications | Interactions when relevant."""


def rag_query(
    question: str,
    plant_filter: str | None = None,
    n_results: int = 5,
) -> dict:
    """
    Retrieve relevant chunks from ChromaDB then generate an answer via Groq.

    Args:
        question: The user's question string.
        plant_filter: Optional — restrict retrieval to one plant name.
        n_results: Number of chunks to retrieve.

    Returns:
        {
            "answer": str,
            "sources": [{"plant": str, "source": str, "excerpt": str}],
            "retrieved_chunks": int,
            "model": str,
        }
    """
    collection = get_collection()

    where = {"plant": plant_filter} if plant_filter else None

    results = collection.query(
        query_texts=[question],
        n_results=n_results,
        where=where,
        include=["documents", "metadatas", "distances"],
    )

    docs = results["documents"][0] if results["documents"] else []
    metas = results["metadatas"][0] if results["metadatas"] else []
    distances = results["distances"][0] if results["distances"] else []

    if not docs:
        return {
            "answer": (
                "I don't have enough information about that in my knowledge base. "
                "Please consult a qualified Ayurvedic practitioner."
            ),
            "sources": [],
            "retrieved_chunks": 0,
            "model": GROQ_MODEL,
        }

    # Build context from retrieved chunks
    context_parts = []
    for i, (doc, meta) in enumerate(zip(docs, metas)):
        source_label = meta.get("source", "unknown")
        plant_label = (
            meta.get("plant") or meta.get("name") or meta.get("dosha")
            or meta.get("topic") or meta.get("filename") or "General"
        )
        context_parts.append(
            f"[Source {i+1} — {plant_label} ({source_label})]:\n{doc}"
        )
    context = "\n\n".join(context_parts)

    # Generate answer with Groq (free)
    groq_client = get_groq()
    response = groq_client.chat.completions.create(
        model=GROQ_MODEL,
        messages=[
            {"role": "system", "content": SYSTEM_PROMPT},
            {
                "role": "user",
                "content": (
                    f"Context from knowledge base:\n\n{context}\n\n"
                    f"Question: {question}"
                ),
            },
        ],
        temperature=0.3,
        max_tokens=600,
    )

    answer = response.choices[0].message.content.strip()

    # Build sources list — filter low-relevance results
    sources = []
    for doc, meta, dist in zip(docs, metas, distances):
        if dist < 0.7:
            sources.append({
                "plant": (
                    meta.get("plant") or meta.get("name") or meta.get("dosha")
                    or meta.get("topic") or meta.get("filename") or "General"
                ),
                "source": meta.get("source", "unknown"),
                "excerpt": doc[:200] + "..." if len(doc) > 200 else doc,
            })

    return {
        "answer": answer,
        "sources": sources[:3],
        "retrieved_chunks": len(docs),
        "model": GROQ_MODEL,
    }
