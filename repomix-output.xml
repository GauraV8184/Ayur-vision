from __future__ import annotations

"""
Central paths for raw Indian Medicinal Leaves data and YOLO-generated crops.

Training prefers the cropped tree when present (matches inference).
"""

from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
PROJECT_ROOT = SCRIPT_DIR.parent

# Original dataset layout (see train.py / README).
DATASET_BASE = PROJECT_ROOT / "datasets" / "Indian Medicinal Leaves Image Datasets"

# Generated by prepare_cropped_dataset.py — class folders mirror the raw dataset.
CROPPED_DATASET_DIR = DATASET_BASE / "cropped_leaf_dataset"

# Custom YOLOv8 leaf detection dataset (YOLO format).
# Expected structure under YOLO_DETECTION_DATASET_DIR:
#   images/train, images/val, labels/train, labels/val
# plus a dataset YAML describing a single class: leaf.
YOLO_DETECTION_DATASET_DIR = PROJECT_ROOT / "datasets" / "leaf_detection_yolo"
YOLO_DETECTION_YAML = YOLO_DETECTION_DATASET_DIR / "leaf_dataset.yaml"

# Default base model to start detector training from.
YOLO_BASE_MODEL = "yolov8n.pt"


def resolve_raw_dataset_dir() -> Path:
    """
    Same resolution rules as historical train.get_data_directory(), as Path.
    """
    if not DATASET_BASE.exists():
        raise FileNotFoundError(
            f"Dataset base not found: {DATASET_BASE}. "
            "Place 'Indian Medicinal Leaves Image Datasets' under datasets/."
        )
    for name in ("Medicinal leaf dataset", "Medicinal plant dataset"):
        candidate = DATASET_BASE / name
        if candidate.is_dir():
            subdirs = [d for d in candidate.iterdir() if d.is_dir()]
            if subdirs:
                return candidate
    subdirs = [d for d in DATASET_BASE.iterdir() if d.is_dir()]
    if subdirs:
        return DATASET_BASE
    raise FileNotFoundError(
        f"No class subfolders found under {DATASET_BASE}. "
        "Expected: <dataset_dir>/<PlantName>/<images>."
    )


def is_cropped_dataset_ready(root: Path | None = None) -> bool:
    """True if cropped dataset root exists and contains at least one image in a class folder."""
    root = root or CROPPED_DATASET_DIR
    if not root.is_dir():
        return False
    subdirs = [d for d in root.iterdir() if d.is_dir()]
    if not subdirs:
        return False
    image_exts = {".jpg", ".jpeg", ".png", ".bmp", ".webp", ".gif"}
    for d in subdirs:
        for p in d.iterdir():
            if p.is_file() and p.suffix.lower() in image_exts:
                return True
    return False
