from __future__ import annotations

import re
from typing import Any


_SECTION_ALIASES: list[tuple[str, str]] = [
    ("nidana sthanam", "Nidana Sthanam"),
    ("nidāna sthanam", "Nidana Sthanam"),
    ("nidana-sthanam", "Nidana Sthanam"),
    ("sarira sthanam", "Sarira Sthanam"),
    ("śārīra sthanam", "Sarira Sthanam"),
    ("sarira-sthanam", "Sarira Sthanam"),
    ("chikitsa sthanam", "Chikitsa-Sthanam"),
    ("cikitsā sthanam", "Chikitsa-Sthanam"),
    ("chikitsa-sthanam", "Chikitsa-Sthanam"),
    ("kalpa-sthanam", "Kalpa-Sthanam"),
    ("kalpa sthanam", "Kalpa-Sthanam"),
    ("sutra sthanam", "Sutra Sthanam"),
    ("sutra-sthanam", "Sutra Sthanam"),
    ("uttara tantra", "Uttara Tantra"),
]


_DOSHAS = {
    "vata": "Vata",
    "vāta": "Vata",
    "vayu": "Vayu",
    "vāyu": "Vayu",
    "pitta": "Pitta",
    "kapha": "Kapha",
}


_TREATMENT_MODALITIES: list[tuple[str, str]] = [
    ("vasti", "Vasti-Karma"),
    ("basti", "Vasti-Karma"),
    ("enema", "Enema"),
    ("panchakarma", "Panchakarma"),
    ("pañcakarma", "Panchakarma"),
    ("nasya", "Nasya"),
    ("virechana", "Virechana"),
    ("vamana", "Vamana"),
    ("raktamoksh", "Raktamokshana"),
    ("rakta moksh", "Raktamokshana"),
    ("lepa", "Lepa"),
    ("snehana", "Snehana"),
    ("swedana", "Swedana"),
    ("sveda", "Swedana"),
]


_FORMULATION_TYPES: list[tuple[str, str]] = [
    ("churna", "Churna"),
    ("curna", "Churna"),
    ("kashaya", "Kashaya"),
    ("kvatha", "Kashaya"),
    ("ghrita", "Ghrita"),
    ("ghee", "Ghrita"),
    ("vati", "Vati"),
    ("gutika", "Vati"),
    ("asava", "Asava"),
    ("arishta", "Arishta"),
    ("bhasma", "Bhasma"),
    ("taila", "Taila"),
    ("avaleha", "Avaleha"),
    ("lehyam", "Avaleha"),
]


_DISEASE_HINTS: list[tuple[str, str]] = [
    ("vyadhi", "Vyadhi"),
    ("vāta-vyādhi", "Vata-vyadhi"),
    ("vata-vyadhi", "Vata-vyadhi"),
    ("ulcer", "Ulcer"),
    ("vrana", "Vrana"),
    ("poison", "Poisoning"),
    ("viṣa", "Poisoning"),
]


_ANATOMY_TERMS: list[str] = [
    "marma",
    "mansa",
    "sira",
    "snayu",
    "asthi",
    "sandhi",
    "rectum",
    "hridaya",
    "hṛdaya",
    "netra",
    "shir",
    "śira",
    "guda",
]


def _uniq_preserve_order(items: list[str]) -> list[str]:
    seen: set[str] = set()
    out: list[str] = []
    for x in items:
        if x not in seen:
            out.append(x)
            seen.add(x)
    return out


def infer_sthanam_section(text: str) -> str | None:
    t = text.lower()
    for needle, label in _SECTION_ALIASES:
        if needle in t:
            return label
    return None


def infer_chapter_number(text: str) -> int | None:
    # Common patterns: "Chapter 6", "CHAPTER VI", "CH. 6"
    m = re.search(r"\bchapter\s+(\d{1,3})\b", text, flags=re.IGNORECASE)
    if m:
        try:
            return int(m.group(1))
        except Exception:
            return None
    m = re.search(r"\bch\.\s*(\d{1,3})\b", text, flags=re.IGNORECASE)
    if m:
        try:
            return int(m.group(1))
        except Exception:
            return None
    return None


def infer_chapter_title(text: str) -> str | None:
    # Try to capture something like "(Vata-vyadhi Nidanam)" or a title after "discourse on"
    m = re.search(r"\(([^)]{4,120})\)", text)
    if m:
        title = m.group(1).strip()
        if title and not re.fullmatch(r"\d+", title):
            return title

    m = re.search(
        r"\bdiscourse\s+on\s+the\s+([A-Za-z0-9\-—–'\s]{4,120})",
        text,
        flags=re.IGNORECASE,
    )
    if m:
        return " ".join(m.group(1).split()).strip(" .:-—–")
    return None


def infer_ayurvedic_domain(sthanam_section: str | None) -> str | None:
    if not sthanam_section:
        return None
    mapping = {
        "Nidana Sthanam": "Nidana",
        "Sarira Sthanam": "Sharira",
        "Chikitsa-Sthanam": "Chikitsa",
        "Kalpa-Sthanam": "Kalpa",
        "Sutra Sthanam": "Sutra",
        "Uttara Tantra": "Uttara",
    }
    return mapping.get(sthanam_section) or sthanam_section


def infer_list_field(text: str, rules: list[tuple[str, str]]) -> list[str]:
    t = text.lower()
    out: list[str] = []
    for needle, label in rules:
        if needle in t:
            out.append(label)
    return _uniq_preserve_order(out)


def infer_doshas(text: str) -> list[str]:
    t = text.lower()
    out: list[str] = []
    for needle, label in _DOSHAS.items():
        if needle in t:
            out.append(label)
    return _uniq_preserve_order(out)


def infer_anatomical_focus(text: str) -> list[str]:
    t = text.lower()
    hits: list[str] = []
    for term in _ANATOMY_TERMS:
        if re.search(rf"\b{re.escape(term)}\b", t):
            hits.append(term.capitalize() if term.isascii() else term)
    # Normalize some common Sanskrit transliterations to nicer labels
    normalized: list[str] = []
    for h in hits:
        if h.lower() == "marma":
            normalized.append("Marma")
        elif h.lower() == "mansa":
            normalized.append("Mansa")
        elif h.lower() == "sira":
            normalized.append("Sira")
        elif h.lower() == "snayu":
            normalized.append("Snayu")
        elif h.lower() == "asthi":
            normalized.append("Asthi")
        elif h.lower() == "sandhi":
            normalized.append("Sandhi")
        elif h.lower() == "guda":
            normalized.append("Rectum")
        else:
            normalized.append(h)
    return _uniq_preserve_order(normalized)


def generate_chunk_metadata(
    *,
    chunk_text: str,
    document_source: str,
    chunk_index: int | None = None,
) -> dict[str, Any]:
    """
    Return metadata matching the fields you specified.

    This is rule-based inference (no LLM). Fields not confidently inferred are omitted
    or defaulted to empty lists where appropriate.
    """
    sthanam_section = infer_sthanam_section(chunk_text)
    chapter_number = infer_chapter_number(chunk_text)
    chapter_title = infer_chapter_title(chunk_text)
    ayurvedic_domain = infer_ayurvedic_domain(sthanam_section)

    metadata: dict[str, Any] = {
        "document_source": document_source,
        "dosha_focus": infer_doshas(chunk_text),
        "disease_category": infer_list_field(chunk_text, _DISEASE_HINTS),
        "treatment_modality": infer_list_field(chunk_text, _TREATMENT_MODALITIES),
        "formulation_type": infer_list_field(chunk_text, _FORMULATION_TYPES),
        "anatomical_focus": infer_anatomical_focus(chunk_text),
    }

    if sthanam_section:
        metadata["sthanam_section"] = sthanam_section
    if chapter_number is not None:
        metadata["chapter_number"] = chapter_number
    if chapter_title:
        metadata["chapter_title"] = chapter_title
    if ayurvedic_domain:
        metadata["ayurvedic_domain"] = ayurvedic_domain
    if chunk_index is not None:
        metadata["chunk_index"] = int(chunk_index)

    # Best-effort text format detection (kept simple)
    metadata["text_format"] = "Prose" if "\n" not in chunk_text[:200] else "Prose"

    return metadata


def assign_metadata_to_chunks(
    *,
    chunks: list[str],
    document_source: str,
    chunk_ids: list[str] | None = None,
) -> list[dict[str, Any]]:
    """
    Produce rows ready for Supabase upsert:
      [{"chunk_id": ..., "chunk_text": ..., "metadata": {...}}, ...]
    """
    if chunk_ids is not None and len(chunk_ids) != len(chunks):
        raise ValueError("chunk_ids length must match chunks length")

    rows: list[dict[str, Any]] = []
    for i, chunk_text in enumerate(chunks):
        cid = chunk_ids[i] if chunk_ids is not None else f"{document_source}_{i:04d}"
        rows.append(
            {
                "chunk_id": cid,
                "chunk_text": chunk_text,
                "metadata": generate_chunk_metadata(
                    chunk_text=chunk_text,
                    document_source=document_source,
                    chunk_index=i,
                ),
            }
        )
    return rows
