// CORS: allow frontend from localhost or 127.0.0.1 (Vite default port)
app.use(
  cors({
    origin: [
      "http://localhost:5173",
      "http://127.0.0.1:5173",
      "http://localhost:3000",
      "http://127.0.0.1:3000",
    ],
    credentials: true,
  })
);

// Parse incoming JSON
app.use(express.json());

// API routes
app.use("/api/auth", authRoutes);
