import express from "express";
import type { Request, Response } from "express";
import authMiddleware from "../middleware/authMiddleware.js";

const router = express.Router();
const AI_SERVICE_URL = process.env.AI_SERVICE_URL || "http://localhost:5000";

router.post("/knowledge", authMiddleware, async (req: Request, res: Response) => {
  const { question, plant } = req.body;

  if (!question || typeof question !== "string" || question.trim().length < 3) {
    return res.status(400).json({ message: "A valid question is required." });
  }

  try {
    const response = await fetch(`${AI_SERVICE_URL}/rag-query`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        question: question.trim(),
        plant: plant || null,
      }),
    });

    if (!response.ok) {
      const err = await response.json().catch(() => ({}));
      return res.status(502).json({
        message: err.error || "Knowledge service unavailable.",
