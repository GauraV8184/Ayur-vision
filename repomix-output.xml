"""
AyurVision RAG — Simple ingestion pipeline (Supabase).

Pipeline:
  1) Read PDFs in ai-service/rag/services/documents/
  2) Chunk text (rag/utils/chunker.py)
  3) Add metadata per chunk
  4) Upsert into Supabase (rag/config/elastic_db.py)

Run:
  python -m rag.services.ingest
"""

import logging
import os
import time
from pathlib import Path

from rag.utils.chunker import chunk_text
from rag.utils.pdf_reader import extract_pdf

logging.basicConfig(level=logging.INFO, format="%(asctime)s [%(levelname)s] %(message)s")
logger = logging.getLogger(__name__)

SCRIPT_DIR = Path(__file__).resolve().parent
AI_SERVICE_DIR = SCRIPT_DIR.parent
DOCUMENTS_DIR = SCRIPT_DIR / "documents"
DOCUMENTS_DIR.mkdir(exist_ok=True)

def _get_supabase():
    # Kept local so imports are fast and errors are clearer
    from rag.config.elastic_db import connect_supabase

    return connect_supabase()


def _should_store_embeddings() -> bool:
    """
    Embeddings are optional in Supabase. Enable explicitly to avoid surprise slowness.
    """
    return (os.getenv("RAG_STORE_EMBEDDINGS") or "").strip().lower() in ("1", "true", "yes", "y", "on")


def _pdf_prefix(pdf_path: Path) -> str:
    # Stable, readable IDs
    return pdf_path.stem.lower().replace(" ", "_")


def ingest_pdfs_to_supabase(supabase):
    from rag.config.elastic_db import upsert_chunks
    from rag.utils.embeddings import get_embeddings
    from rag.utils.generate_metadata import assign_metadata_to_chunks

    pdfs = list(DOCUMENTS_DIR.glob("*.pdf"))
    if not pdfs:
        logger.info("=== No PDFs found — skipping ===")
        return
    logger.info("=== Ingesting %d PDFs into Supabase ===", len(pdfs))
    for pdf_path in pdfs:
        try:
            text = extract_pdf(str(pdf_path))
            chunks = chunk_text(text)
            prefix = _pdf_prefix(pdf_path)
            chunk_ids = [f"{prefix}_{i:04d}" for i in range(len(chunks))]

            rows = assign_metadata_to_chunks(
                chunks=chunks,
                document_source=pdf_path.name,
                chunk_ids=chunk_ids,
            )

            if _should_store_embeddings():
                for row in rows:
                    emb = get_embeddings(row["chunk_text"])
                    if emb is not None:
                        row["embedding"] = emb

            resp = upsert_chunks(supabase, rows)
            added = int(resp.get("upserted", 0))
            logger.info("  %s: +%d chunks", pdf_path.name, added)
        except Exception as e:
            logger.error("  %s failed: %s", pdf_path.name, e)


# ── Main ───────────────────────────────────────────────────────────────────
def main():
    logger.info("Starting AyurVision RAG — PDF -> chunks -> Supabase")
    supabase = _get_supabase()
    start = time.time()

    ingest_pdfs_to_supabase(supabase)

    logger.info(
        "=== Ingestion complete in %.2fs. Stored in Supabase table '%s'. ===",
        time.time() - start,
        os.getenv("RAG_CHUNKS_TABLE") or "rag_chunks",
    )


if __name__ == "__main__":
    main()
