"""
Shared YOLOv8 leaf ROI extraction for inference and dataset preparation.

Used by predict.py (API) and prepare_cropped_dataset.py (training pipeline).
Does not import TensorFlow — safe to import from lightweight scripts.
"""

from __future__ import annotations

import logging
import json
from pathlib import Path
from typing import Optional, Tuple

import numpy as np
from PIL import Image as PILImage
from ultralytics import YOLO

logger = logging.getLogger(__name__)

SCRIPT_DIR = Path(__file__).resolve().parent

# Weights: base YOLOv8n via download_yolo.py, or replace with fine-tuned leaf detector.
YOLO_MODEL_PATH = SCRIPT_DIR / "model" / "yolo_leaf.pt"
YOLO_MODEL_META_PATH = SCRIPT_DIR / "model" / "yolo_leaf.meta.json"
YOLO_CONF_THRESHOLD = 0.25

# Must match EfficientNet training input in train.py / predict.py TTA path.
CLASSIFIER_IMG_SIZE = (300, 300)

_yolo_model: Optional[YOLO] = None
_yolo_weights_path: Optional[Path] = None


def load_yolo_detector(weights_path: Optional[Path] = None) -> YOLO:
    """
    Lazy-load Ultralytics YOLO. Caches by resolved weights path.
    """
    global _yolo_model, _yolo_weights_path
    path = Path(weights_path) if weights_path is not None else YOLO_MODEL_PATH
    path = path.resolve()
    if not path.is_file():
        raise FileNotFoundError(
            f"YOLO model not found: {path}. "
            "Train a custom leaf detector (train_leaf_detector.py) or download base weights (download_yolo.py) first."
        )
    if _yolo_model is not None and _yolo_weights_path == path:
        return _yolo_model
    meta = None
    if weights_path is None and YOLO_MODEL_META_PATH.is_file():
        try:
            meta = json.loads(YOLO_MODEL_META_PATH.read_text(encoding="utf-8"))
        except Exception:
            meta = None
    if meta and isinstance(meta, dict):
        src = meta.get("source") or "unknown"
        note = meta.get("note") or ""
        logger.info("Loading YOLO detector from %s (source=%s %s)", path, src, note)
        if src == "base-yolov8n":
            logger.warning(
                "YOLO detector weights are base COCO weights (not leaf-specific). "
                "Expect more fallback until you fine-tune on leaf boxes."
            )
    else:
        logger.info("Loading YOLO detector from %s", path)
    _yolo_model = YOLO(str(path))
    _yolo_weights_path = path
    return _yolo_model


def _best_xyxy_from_results(results, pil_w: int, pil_h: int) -> Optional[Tuple[int, int, int, int]]:
    boxes = results[0].boxes
    if boxes is None or len(boxes) == 0:
        return None
    best_i = int(boxes.conf.argmax().item())
    bb = boxes.xyxy[best_i]
    flat = bb.cpu().flatten().tolist() if hasattr(bb, "cpu") else list(np.asarray(bb).flat)
    x1, y1, x2, y2 = map(int, flat)
    x1, y1 = max(0, x1), max(0, y1)
    x2, y2 = min(pil_w, x2), min(pil_h, y2)
    if x2 <= x1 or y2 <= y1:
        return None
    return x1, y1, x2, y2


def extract_leaf_roi_pil(
    image_path: Path,
    *,
    yolo_model: Optional[YOLO] = None,
    conf: Optional[float] = None,
) -> Tuple[PILImage.Image, bool]:
    """
    Run YOLO on disk path, crop best box, resize to CLASSIFIER_IMG_SIZE.

    Returns:
        (RGB PIL image, yolo_detected) — yolo_detected False if no/invalid box (full-image resize).
    """
    path = Path(image_path)
    model = yolo_model if yolo_model is not None else load_yolo_detector()
    c = YOLO_CONF_THRESHOLD if conf is None else conf

    results = model(str(path), conf=c, verbose=False)
    pil_full = PILImage.open(path).convert("RGB")
    w, h = pil_full.size

    xyxy = _best_xyxy_from_results(results, w, h)
    if xyxy is None:
        logger.warning(
            "YOLOv8: no valid leaf box for %s — using full-image fallback",
            path.name,
        )
        out = pil_full.resize(CLASSIFIER_IMG_SIZE, PILImage.BILINEAR)
        return out, False

    x1, y1, x2, y2 = xyxy
    out = pil_full.crop((x1, y1, x2, y2)).resize(CLASSIFIER_IMG_SIZE, PILImage.BILINEAR)
    return out, True


def leaf_roi_to_classifier_array(pil_rgb: PILImage.Image) -> np.ndarray:
    """RGB float32 [0, 255], shape (H, W, 3) — matches legacy classifier input."""
    return np.asarray(pil_rgb, dtype=np.float32)


def extract_leaf_for_classifier(
    image_path: Path,
    *,
    yolo_model: Optional[YOLO] = None,
    conf: Optional[float] = None,
) -> Tuple[np.ndarray, bool]:
    """Convenience for predict.py: ndarray ready for EfficientNet + TTA."""
    pil_img, detected = extract_leaf_roi_pil(
        image_path, yolo_model=yolo_model, conf=conf
    )
    return leaf_roi_to_classifier_array(pil_img), detected
