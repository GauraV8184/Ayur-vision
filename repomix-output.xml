"""
Downloads YOLOv8n weights to ai-service/model/yolo_leaf.pt.
Run once before starting api.py if you don't have a custom-trained YOLO model:
    python download_yolo.py
For production, replace yolo_leaf.pt with a model fine-tuned on leaf/plant detection data.
"""
import json
import shutil
from pathlib import Path

from ultralytics import YOLO

from leaf_detection import YOLO_MODEL_META_PATH, YOLO_MODEL_PATH

MODEL_DIR = YOLO_MODEL_PATH.parent
MODEL_DIR.mkdir(parents=True, exist_ok=True)
DEST = YOLO_MODEL_PATH

if DEST.exists():
    print(f"Already exists: {DEST}")
else:
    print("Downloading YOLOv8n base weights...")
    _ = YOLO("yolov8n.pt")  # downloads to ultralytics cache
    import ultralytics

    cache = Path(ultralytics.__file__).parent / "assets" / "yolov8n.pt"
    if not cache.exists():
        cache = Path("yolov8n.pt")
    if cache.exists():
        shutil.copy(cache, DEST)
        print(f"Saved to {DEST}")
        YOLO_MODEL_META_PATH.write_text(
            json.dumps(
                {
                    "source": "base-yolov8n",
                    "trained_from": "yolov8n.pt",
                    "note": "COCO-pretrained base weights (not leaf-specific)",
                },
                indent=2,
            ),
            encoding="utf-8",
        )
    else:
        alt = Path.cwd() / "yolov8n.pt"
        if alt.exists():
            shutil.copy(alt, DEST)
            print(f"Saved to {DEST}")
            YOLO_MODEL_META_PATH.write_text(
                json.dumps(
                    {
                        "source": "base-yolov8n",
                        "trained_from": "yolov8n.pt",
                        "note": "COCO-pretrained base weights (not leaf-specific)",
                    },
                    indent=2,
                ),
                encoding="utf-8",
            )
        else:
            print(
                f"WARNING: Could not locate downloaded weights. "
                f"Check ultralytics cache and copy manually to {DEST}"
            )
