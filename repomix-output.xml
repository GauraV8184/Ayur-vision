import { getJSON, setJSON, STORAGE_KEYS } from "../../utils/storage";
import { getPatientById } from "../../services/patientService";
import { useToast } from "../../components/toast/ToastContext";
import Loader from "../../components/ui/Loader";
import {
  formatReportDate,
  getDominantDosha,
