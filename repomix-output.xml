                className={`flex items-center gap-1.5 text-sm ${
                  m.status === "active"
                    ? "text-emerald-600 dark:text-emerald-400"
                    : m.status === "checking"
                    ? "text-amber-500"
                    : "text-red-500"
                }`}
              >
                {m.status === "checking" ? (
                  <Loader2 className="h-4 w-4 animate-spin" />
                ) : m.status === "active" ? (
                  <CheckCircle className="h-4 w-4" />
                ) : (
                  <Circle className="h-4 w-4" />
                )}
                {m.status}
              </span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  );
}
