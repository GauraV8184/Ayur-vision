<file path="ai-service/yolo_dataset_utils.py">
"""
Utilities for a single-class YOLOv8 leaf detection dataset.

Expected dataset root:
  images/train, images/val
  labels/train, labels/val

Each label file is YOLO txt with class id 0 only: leaf.
"""

from __future__ import annotations

import logging
from pathlib import Path
from typing import Dict, Tuple

logger = logging.getLogger(__name__)

IMAGE_EXTS = {".jpg", ".jpeg", ".png", ".bmp", ".webp"}


def _count_images(dir_path: Path) -> int:
    if not dir_path.is_dir():
        return 0
    return sum(1 for p in dir_path.iterdir() if p.is_file() and p.suffix.lower() in IMAGE_EXTS)


def _count_labels(dir_path: Path) -> int:
    if not dir_path.is_dir():
        return 0
    return sum(1 for p in dir_path.iterdir() if p.is_file() and p.suffix.lower() == ".txt")


def validate_yolo_leaf_dataset(root: Path) -> Dict[str, object]:
    """
    Validates the folder structure and returns summary stats.
    Raises ValueError with a clear message if structure is invalid.
    """
    root = Path(root)
    required = [
        root / "images" / "train",
        root / "images" / "val",
        root / "labels" / "train",
        root / "labels" / "val",
    ]
    missing = [p for p in required if not p.is_dir()]
    if missing:
        raise ValueError(
            "Invalid YOLO dataset structure. Missing directories:\n"
            + "\n".join(f"- {p}" for p in missing)
            + "\nExpected: images/train, images/val, labels/train, labels/val"
        )

    img_train = _count_images(root / "images" / "train")
    img_val = _count_images(root / "images" / "val")
    lbl_train = _count_labels(root / "labels" / "train")
    lbl_val = _count_labels(root / "labels" / "val")

    if img_train == 0 or img_val == 0:
        raise ValueError(
            f"YOLO dataset has no images. train={img_train}, val={img_val}. "
            "Add images under images/train and images/val."
        )

    # Labels are recommended but not strictly required for every image (some tools allow empty labels).
    if lbl_train == 0 or lbl_val == 0:
        logger.warning(
            "YOLO labels seem empty. labels/train=%d labels/val=%d. "
            "Training will fail if annotations are missing.",
            lbl_train,
            lbl_val,
        )

    return {
        "root": str(root.resolve()),
        "images_train": img_train,
        "images_val": img_val,
        "labels_train": lbl_train,
        "labels_val": lbl_val,
    }


def write_single_class_yaml(dataset_root: Path, yaml_path: Path) -> Path:
    """
    Writes a minimal Ultralytics YAML for a single class: leaf.
    """
    dataset_root = Path(dataset_root).resolve()
    yaml_path = Path(yaml_path).resolve()
    yaml_path.parent.mkdir(parents=True, exist_ok=True)

    content = (
        f"path: {dataset_root.as_posix()}\n"
        "train: images/train\n"
        "val: images/val\n"
        "nc: 1\n"
        "names: [leaf]\n"
    )
    yaml_path.write_text(content, encoding="utf-8")
    return yaml_path
