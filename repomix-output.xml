<file path="frontend/src/pages/app/KnowledgeAssistantPage.tsx">
import { useState, useRef, useEffect } from "react";
import { Send, Loader2, BookOpen, AlertCircle, ChevronDown, ChevronUp } from "lucide-react";
import { askKnowledge } from "../../services/api";

const SUGGESTED_QUESTIONS = [
  "What are the Panchakarma procedures and their indications?",
  "Dosage and contraindications for Trikatu Churna?",
  "How to treat Amavata (Rheumatoid Arthritis) in Ayurveda?",
  "What are the drug interactions of Guggulu?",
  "Explain Dinacharya — the Ayurvedic daily routine",
  "What foods aggravate Vata dosha?",
  "Difference between Vataja and Pittaja Jwara treatment?",
  "How is Chyawanprash prepared and what are its benefits?",
];

interface KnowledgeSource {
  plant: string;
  source: string;
  excerpt: string;
}

interface ChatMessage {
  role: "user" | "assistant";
  content: string;
  sources?: KnowledgeSource[];
  error?: string;
  model?: string | null;
}

function SourceCard({ source }: { source: KnowledgeSource }) {
  const [expanded, setExpanded] = useState(false);
  return (
    <div className="rounded-lg border border-stone-200 bg-stone-50 p-3 dark:border-stone-700 dark:bg-stone-800/50">
      <div className="flex items-center justify-between">
        <div className="flex items-center gap-2">
          <BookOpen className="h-3.5 w-3.5 text-emerald-600 dark:text-emerald-400" />
          <span className="text-xs font-medium text-stone-700 dark:text-stone-300">
            {source.plant}
          </span>
          <span className="rounded-full bg-stone-200 px-1.5 py-0.5 text-xs text-stone-500 dark:bg-stone-700 dark:text-stone-400 capitalize">
            {source.source}
          </span>
        </div>
        <button
          onClick={() => setExpanded(!expanded)}
          className="text-stone-400 hover:text-stone-600 dark:hover:text-stone-200"
        >
          {expanded ? <ChevronUp className="h-3.5 w-3.5" /> : <ChevronDown className="h-3.5 w-3.5" />}
        </button>
      </div>
      {expanded && (
        <p className="mt-2 text-xs text-stone-500 dark:text-stone-400 leading-relaxed">
          {source.excerpt}
        </p>
      )}
    </div>
  );
}

function Message({ msg }: { msg: ChatMessage }) {
  return (
    <div className={`flex ${msg.role === "user" ? "justify-end" : "justify-start"}`}>
      <div className={`max-w-[80%] space-y-2 ${msg.role === "user" ? "items-end" : "items-start"} flex flex-col`}>
        <div
          className={`rounded-2xl px-4 py-3 text-sm leading-relaxed ${
            msg.role === "user"
              ? "bg-emerald-600 text-white rounded-br-sm"
              : "bg-white border border-stone-200 text-stone-800 rounded-bl-sm dark:bg-stone-800 dark:border-stone-700 dark:text-stone-200"
          }`}
        >
          {msg.content}
        </div>
        {msg.sources && msg.sources.length > 0 && (
          <div className="w-full space-y-1.5">
            <p className="text-xs text-stone-400 px-1">Sources</p>
            {msg.sources.map((s, i) => (
              <SourceCard key={i} source={s} />
            ))}
          </div>
        )}
        {msg.error && (
          <div className="flex items-center gap-1.5 text-xs text-red-500">
            <AlertCircle className="h-3.5 w-3.5" />
            {msg.error}
          </div>
        )}
        {msg.model && (
          <p className="text-xs text-stone-300 px-1">via {msg.model}</p>
        )}
      </div>
    </div>
  );
}

export default function KnowledgeAssistantPage() {
  const [messages, setMessages] = useState<ChatMessage[]>([
    {
      role: "assistant",
      content:
        "Hello! I'm the AyurVision knowledge assistant. Ask me anything about ayurvedic plants — their medicinal uses, preparation methods, dosages, or interactions.",
    },
  ]);
  const [input, setInput] = useState("");
  const [loading, setLoading] = useState(false);
  const bottomRef = useRef<HTMLDivElement | null>(null);

  useEffect(() => {
    bottomRef.current?.scrollIntoView({ behavior: "smooth" });
  }, [messages]);

  const sendMessage = async (question?: string) => {
    const text = (question ?? input).trim();
    if (!text || loading) return;

    setInput("");
    setMessages((prev) => [...prev, { role: "user", content: text }]);
    setLoading(true);

    try {
      const { data } = await askKnowledge(text);
      setMessages((prev) => [
        ...prev,
        {
          role: "assistant",
          content: data.answer,
          sources: data.sources || [],
          model: data.model || null,
        },
      ]);
    } catch (err: unknown) {
      const axiosErr = err as {
        response?: { data?: { message?: string } };
      };
      const errMsg =
        axiosErr.response?.data?.message ||
        "Could not reach the knowledge service. Make sure the AI service is running.";
      setMessages((prev) => [
        ...prev,
        {
          role: "assistant",
          content: "Sorry, I couldn't process that question.",
          error: errMsg,
        },
      ]);
    } finally {
      setLoading(false);
    }
  };

  const handleKeyDown = (e: import("react").KeyboardEvent<HTMLTextAreaElement>) => {
    if (e.key === "Enter" && !e.shiftKey) {
      e.preventDefault();
      sendMessage();
    }
  };

  return (
    <div className="mx-auto flex h-[calc(100vh-8rem)] max-w-3xl flex-col">
      <div className="mb-4 shrink-0">
        <h1 className="text-2xl font-semibold text-stone-900 dark:text-stone-100">
          Knowledge Assistant
        </h1>
        <p className="mt-1 text-sm text-stone-500 dark:text-stone-400">
          Ask about medicinal uses, dosages, preparations, and interactions.
        </p>
      </div>

      {messages.length === 1 && (
        <div className="mb-4 shrink-0 flex flex-wrap gap-2">
          {SUGGESTED_QUESTIONS.map((q) => (
            <button
              key={q}
              onClick={() => sendMessage(q)}
              className="rounded-full border border-stone-200 bg-white px-3 py-1.5 text-xs text-stone-600 hover:border-emerald-400 hover:text-emerald-700 transition-colors dark:border-stone-700 dark:bg-stone-800 dark:text-stone-400 dark:hover:border-emerald-500 dark:hover:text-emerald-400"
            >
              {q}
            </button>
          ))}
        </div>
      )}

      <div className="flex-1 overflow-y-auto space-y-4 pr-1 pb-4">
        {messages.map((msg, i) => (
          <Message key={i} msg={msg} />
        ))}
        {loading && (
          <div className="flex justify-start">
            <div className="flex items-center gap-2 rounded-2xl rounded-bl-sm border border-stone-200 bg-white px-4 py-3 dark:border-stone-700 dark:bg-stone-800">
              <Loader2 className="h-4 w-4 animate-spin text-emerald-600" />
              <span className="text-sm text-stone-500">Searching knowledge base...</span>
            </div>
          </div>
        )}
        <div ref={bottomRef} />
      </div>

      <div className="shrink-0 pt-2">
        <div className="flex items-end gap-2 rounded-2xl border border-stone-200 bg-white p-2 shadow-sm dark:border-stone-700 dark:bg-stone-800">
          <textarea
            value={input}
            onChange={(e) => setInput(e.target.value)}
            onKeyDown={handleKeyDown}
            placeholder="Ask about any ayurvedic plant..."
            rows={1}
            className="flex-1 resize-none bg-transparent px-2 py-1.5 text-sm text-stone-800 placeholder-stone-400 outline-none dark:text-stone-200"
          />
          <button
            onClick={() => sendMessage()}
            disabled={!input.trim() || loading}
            className="flex h-8 w-8 shrink-0 items-center justify-center rounded-xl bg-emerald-600 text-white hover:bg-emerald-700 disabled:opacity-40 disabled:cursor-not-allowed transition-colors"
          >
            <Send className="h-4 w-4" />
          </button>
        </div>
        <p className="mt-1.5 text-center text-xs text-stone-400">
          Powered by Groq + Llama 3.1 · Always consult a practitioner for medical advice.
        </p>
      </div>
    </div>
  );
}
</file>

