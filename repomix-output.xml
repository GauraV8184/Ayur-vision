import os
from typing import Any, Iterable, Sequence

from dotenv import load_dotenv

load_dotenv()

# ---------------------------------------------------------------------------
# Supabase migration (Postgres) + client helpers
# ---------------------------------------------------------------------------
#
# Supabase does not support running DDL via the standard PostgREST API.
# Apply the SQL below in Supabase (SQL Editor) or via Supabase migrations.
#
# Storage shape (matches your expected output):
#   chunk_id   : text (PK)
#   chunk_text : text
#   metadata   : jsonb (nested metadata object)
#   embedding  : optional (pgvector) for semantic search
#
SUPABASE_MIGRATION_SQL = r"""
-- Enable extensions (safe if already enabled)
create extension if not exists pg_trgm;
create extension if not exists vector;

-- Main table
create table if not exists public.rag_chunks (
  chunk_id text primary key,
  chunk_text text not null,
  metadata jsonb not null default '{}'::jsonb,
  -- Optional: store embeddings for similarity search (dims=1024 to match current pipeline)
  embedding vector(1024),
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

-- Keep updated_at current
create or replace function public.set_updated_at()
returns trigger as $$
begin
  new.updated_at = now();
  return new;
end;
$$ language plpgsql;

drop trigger if exists trg_rag_chunks_updated_at on public.rag_chunks;
create trigger trg_rag_chunks_updated_at
before update on public.rag_chunks
for each row execute function public.set_updated_at();

-- Fast keyword-ish filtering/search helpers
create index if not exists idx_rag_chunks_chunk_id_trgm
  on public.rag_chunks using gin (chunk_id gin_trgm_ops);

create index if not exists idx_rag_chunks_chunk_text_trgm
  on public.rag_chunks using gin (chunk_text gin_trgm_ops);

create index if not exists idx_rag_chunks_metadata_gin
  on public.rag_chunks using gin (metadata);

-- Vector index (optional; requires pgvector). Tune lists based on table size.
-- create index if not exists idx_rag_chunks_embedding_ivfflat
--   on public.rag_chunks using ivfflat (embedding vector_cosine_ops) with (lists = 100);
"""


def connect_supabase():
    """
    Create a Supabase client.

    Required env:
      - SUPABASE_URL
      - SUPABASE_SERVICE_ROLE_KEY (recommended for server-side ingestion)

    You may also use SUPABASE_ANON_KEY for read-only client usage.
    """
    supabase_url = (os.getenv("SUPABASE_URL") or "").strip()
    service_role_key = (os.getenv("SUPABASE_SERVICE_ROLE_KEY") or "").strip()
    anon_key = (os.getenv("SUPABASE_ANON_KEY") or "").strip()

    if not supabase_url:
        raise ValueError("SUPABASE_URL is not set")
    supabase_key = service_role_key or anon_key
    if not supabase_key:
        raise ValueError("SUPABASE_SERVICE_ROLE_KEY (or SUPABASE_ANON_KEY) is not set")

    # Local import so importing this module doesn't hard-fail in environments
    # where supabase isn't installed.
    from supabase import create_client  # type: ignore

    return create_client(supabase_url, supabase_key)


def get_chunks_table_name() -> str:
    """Table to store chunk rows (override via RAG_CHUNKS_TABLE if desired)."""
    return (os.getenv("RAG_CHUNKS_TABLE") or "rag_chunks").strip()


def _normalize_chunk_doc(doc: dict[str, Any]) -> dict[str, Any]:
    """
    Ensure doc matches expected shape:
      {"chunk_id": str, "chunk_text": str, "metadata": {...}}
    """
    chunk_id = doc.get("chunk_id")
    chunk_text = doc.get("chunk_text") if doc.get("chunk_text") is not None else doc.get("text")
    metadata = doc.get("metadata") or {}

    if not chunk_id or not isinstance(chunk_id, str):
        raise ValueError("Each chunk must have a non-empty string 'chunk_id'")
    if not chunk_text or not isinstance(chunk_text, str):
        raise ValueError("Each chunk must have a non-empty string 'chunk_text'")

    # Ensure list fields exist (empty list is fine) to match your expected output shape.
    for k in (
        "dosha_focus",
        "disease_category",
        "treatment_modality",
        "formulation_type",
        "anatomical_focus",
    ):
        v = metadata.get(k, [])
        if v is None:
            v = []
        if isinstance(v, str):
            v = [v]
        metadata[k] = list(v)

    # Coerce chapter_number when possible.
    if "chapter_number" in metadata and metadata["chapter_number"] is not None:
        try:
            metadata["chapter_number"] = int(metadata["chapter_number"])
        except Exception:
            pass

    normalized: dict[str, Any] = {
        "chunk_id": chunk_id,
        "chunk_text": chunk_text,
        "metadata": metadata,
    }

    # Preserve embedding if provided (stored as pgvector(1024) if you ran the migration above).
    if "embedding" in doc and doc["embedding"] is not None:
        normalized["embedding"] = doc["embedding"]

    return normalized


def upsert_chunks(
    supabase,
    chunks: Iterable[dict[str, Any]],
    *,
    table: str | None = None,
    chunk_batch_size: int = 500,
) -> dict[str, Any]:
    """
    Upsert chunk documents into Supabase/Postgres.

    Each input item should be either already in expected shape, or at minimum contain:
      - chunk_id
      - chunk_text (or legacy 'text')
      - metadata (dict, optional)
    """
    table_name = table or get_chunks_table_name()
    rows: list[dict[str, Any]] = []
    total_upserted = 0
    last_response: Any | None = None

    def flush(batch: Sequence[dict[str, Any]]):
        nonlocal total_upserted, last_response
        if not batch:
            return
        last_response = (
            supabase.table(table_name)
            .upsert(list(batch), on_conflict="chunk_id")
            .execute()
        )
        total_upserted += len(batch)

    for doc in chunks:
        rows.append(_normalize_chunk_doc(doc))
        if len(rows) >= chunk_batch_size:
            flush(rows)
            rows = []
    flush(rows)

    return {"upserted": total_upserted, "response": last_response}


if __name__ == "__main__":
    print("Supabase migration SQL (run in Supabase SQL Editor / migrations):\n")
    print(SUPABASE_MIGRATION_SQL.strip())
